-- Information block for the plugin

PluginInfo = {
  Name = "Sony PTZ CGI Control", -- The tilde here indicates folder structure in the Shematic Elements pane
	Version = "2.0",
  BuildVersion = "2.0.0.5",
	Id = "8aec1752-b1ca-444a-bb46-5246a9a6a6dd",
  Author = "Matty",
  Description = "Plugin for control of an Sony Camera using the CGI protocol",
}

